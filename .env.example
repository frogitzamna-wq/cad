# BSV CAD System - Environment Configuration
# Copy this file to .env and update with your values

# ===== Network Configuration =====
BSV_NETWORK=mainnet
# Options: mainnet, testnet, stn (Scaling Test Network)

# ===== BSV API Endpoints =====
BROADCAST_URL=https://api.whatsonchain.com/v1/bsv/main/tx/raw
INDEXER_URL=https://api.whatsonchain.com/v1/bsv/main

# ===== Overlay Services =====
UHRP_ENDPOINT=https://uhrp.babbage.systems
MESSAGEBOX_URL=https://messagebox.babbage.systems
DID_RESOLVER_URL=https://identity.bsvblockchain.org

# ===== Database Configuration =====
POSTGRES_DB=cad
POSTGRES_USER=caduser
POSTGRES_PASSWORD=changeme_production_password_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ===== Redis Configuration =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password_here

# ===== Application Configuration =====
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# Options: error, warn, info, debug, trace

# ===== SPV Indexer Configuration =====
POLL_INTERVAL=3000
# Milliseconds between blockchain polls

CHECKPOINT_INTERVAL=10
# Blocks between checkpoints

# ===== Monitoring Configuration =====
PROMETHEUS_PORT=9090
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme_grafana_password_here

# ===== Security Configuration =====
JWT_SECRET=changeme_jwt_secret_minimum_32_characters_long
ENCRYPTION_KEY=changeme_encryption_key_32_bytes_base64

# ===== Rate Limiting =====
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
# 100 requests per minute

# ===== Keys Directory =====
# NEVER commit keys to git!
KEYS_DIR=/app/keys
MASTER_KEY_PATH=/app/keys/master.key

# ===== Deployment Configuration =====
REPLICAS=2
# Number of application replicas for load balancing

MAX_MEMORY=2G
MAX_CPU=2

# ===== Optional: Custom Configurations =====
# NENA_AGENCY_ID=AGENCY-001
# NENA_AGENCY_NAME=Metro Police Department
# NENA_SERVICE_URN=urn:service:sos.police

# ===== Backup Configuration =====
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
# Daily at 2 AM

# ===== Alert Configuration =====
ALERT_EMAIL=ops@example.com
ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
